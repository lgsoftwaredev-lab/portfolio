# Variables de entorno para el Formulario de Contacto Seguro (Vercel)
# Se configuran en: Vercel Dashboard -> Project -> Settings -> Environment Variables

# Destinatarios privados (nunca expuestos en el código)
EMAIL_FREELANCE=tu_correo_freelance@gmail.com
EMAIL_LABORAL=tu_correo_laboral@gmail.com

# Proveedor de envío (elegí la opción que prefieras):

# Opción 1: Resend (Recomendada: 3.000 envíos/mes gratis - https://resend.com)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Opción 2: Formspree (50 envíos/mes gratis - https://formspree.io)
# FORMSPREE_FREELANCE_ID=xxxxxx
# FORMSPREE_LABORAL_ID=yyyyyy

# Opción 3: Web3Forms (Gratis con Access Key - https://web3forms.com)
# WEB3FORMS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
